<Project>
  <!--
    Central Package Management: every NuGet version of the solution lives here.
    Projects reference packages without a Version attribute; adding a package
    means adding (or reusing) a PackageVersion entry below.
    https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!--
      The health-checks dashboard the API hosts serve in Development, under Apache 2.0: the UI
      page and its polling collector, the writer that answers in the format the page reads, and
      the in-memory store its history forgets on restart — deliberately, like Mailpit's mailbox.
      The probe packages of the same family stay out: each probe here is a few lines against a
      client the solution already owns. See ADR 0037.
    -->
    <PackageVersion Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    <!--
      Pinned, not referenced: no project carries a PackageReference to this package. It arrives
      transitively — AspNetCore.HealthChecks.UI 9.0.0 pulls KubernetesClient 15.0.1 for a discovery
      feature this repository never turns on — and that version carries GHSA-w7r3-mgwf-4mqq
      (CVE-2025-9708, CVSS 6.8): the client accepts certificates without verifying the trust chain.
      First patched version is 17.0.14, and transitive pinning (enabled above) is what reaches it
      without waiting for the UI package to move. Remove this line once that package references a
      patched version itself.

      This one line deliberately does not follow the latest release. What a pin of this kind owes is
      the *lowest* version that closes the advisory: the UI package was compiled against the 15.0.1
      API, so every major beyond the fix is a compatibility risk taken on somebody else's behalf,
      and 19.0.2 would add Fractions and YamlDotNet to both API hosts' restore graph for an assembly
      nothing here ever loads.
    -->
    <PackageVersion Include="KubernetesClient" Version="17.0.14" />
    <!--
      Community fork of FluentAssertions 7, under Apache 2.0. FluentAssertions 8 moved to a
      commercial Xceed license; this keeps the same fluent API on a permissive one.
    -->
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <!--
      Renders a Blazor component in-process so a test can drive it. Added because the profile page
      is the first component in this repository carrying logic worth proving — a size check
      mirroring the API's, an address built to defeat a year-long cache, and a failure path that
      shows the server's own words.
    -->
    <PackageVersion Include="bunit" Version="2.9.0" />
    <!--
      The S3 client, under Apache 2.0. Named for Amazon, but nothing here talks to Amazon: the
      adapter points it at whatever endpoint the configuration names, which is a SeaweedFS
      container locally. S3 is the protocol every object store on the shortlist speaks, so the
      choice of client is what makes the provider a configuration value rather than a rewrite —
      the server is the replaceable part. See ADR 0021.
    -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.2" />
    <!--
      Collects line coverage during `dotnet test`, in OpenCover format, for the analysis to read.
      Referenced by every project that runs tests and by no other — an architecture rule checks
      that, because a test project without it reports no coverage at all rather than failing, and
      the quality gate would read the silence as uncovered code.
    -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="EmailValidation" Version="1.4.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <!--
      The SMTP and MIME client, under MIT. Microsoft documents System.Net.Mail.SmtpClient as
      obsolete for new development and names this library as its replacement. SMTP is to mail what
      S3 is to storage in ADR 0021: the protocol every provider on the shortlist speaks, so the
      choice of client is what makes the mail server a configuration value rather than a rewrite —
      locally it is a Mailpit container, in production whatever relay the deployment names. Only the
      infrastructure references it, and an architecture rule holds that line. See ADR 0031.
    -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!--
      Writes the API's OpenAPI document to disk during the build, so the client generator reads a
      file instead of loading the host itself. Only the layered API references it, and only
      scripts/generate-clients.sh turns the emission on. See ADR 0008.
    -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11" />
    <!--
      The framework's own OpenAPI document generator, used by both hosts. It replaced NSwag on one
      and Swashbuckle on the other: two libraries describing one API produced two documents that
      disagreed on nullability and enum representation. See ADR 0006.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!--
      Pinned, not referenced — like KubernetesClient above, and for the same mechanism rather than
      the same reason. No project carries a PackageReference to either of these two; they arrive
      transitively, and transitive pinning (enabled above) is what keeps them on the version the
      rest of the EF and Extensions families are on. Said out loud because a version with no
      visible consumer reads as dead weight, and deleting it would let the graph resolve them
      wherever their dependents happen to point. The InMemory pin earns its keep twice since the
      health dashboard arrived: its storage package asks for the EF 8 provider, which throws
      MissingMethodException against an EF 10 runtime — this line is what boots it on 10.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <!--
      A relational provider for one unit test, and it has to be relational: the schema probe asks
      GetPendingMigrationsAsync, which the in-memory provider above does not answer at all. SQLite
      in memory gives it a real migrations assembly and a real history table to compare against
      without a container, which is what keeps that fact in the suite that runs without Docker
      (ADR 0045). It never touches src/ — the hosts speak SQL Server and nothing else.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!--
      The host builder itself, for DevelopmentSeedExtensionsTests. The seeder is an extension of
      IHost and reaches everything through the scopes it opens, so proving it takes a real host
      rather than a container of services — and src/ needs only the abstractions below, because a
      host is something the API projects are handed rather than something they build.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!--
      IStringLocalizer and AddLocalization for the WebAssembly client, which sits outside the
      shared framework that hands them to the three hosts for free. One package, browser side
      only. See ADR 0088.
    -->
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="MudBlazor" Version="9.8.0" />
    <!--
      Reads compiled assemblies with Mono.Cecil and states an architectural rule as a fluent
      predicate, for TrainingHub.Architecture.Tests. The eNhanced fork rather than
      NetArchTest.Rules: the original has shipped nothing since May 2021 and still carries
      Mono.Cecil 0.11.3, which predates every metadata change since. This one is maintained, and
      its failures name why a type failed and where it is declared — the difference between a
      failure a reader can act on and a boolean. Mono.Cecil itself arrives transitively and needs
      no entry: transitive pinning applies to packages declared here, not to every package resolved.
    -->
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <!--
      The telemetry pipeline of the three hosts, under Apache 2.0: the SDK with its hosting
      integration, the OTLP exporter that carries all three signals over one wire, and the bridges
      that subscribe to what the platform already emits — the request spans and meters ASP.NET Core
      and HttpClient publish themselves, the runtime's counters, and SqlClient's command events.
      Only TrainingHub.Shared.Api and the Blazor host reference any of these: custom
      instrumentation everywhere else speaks the BCL's ActivitySource and Meter, which need no
      package at all, and an architecture rule holds that line. Every entry here is the stable
      1.18.0 train on purpose — the EF Core bridge has never shipped a stable version, so database
      spans come from the SqlClient bridge and database metrics from EF Core's own built-in meter,
      and the process bridge stays out for the same reason, the runtime one covering what matters.
      See ADR 0095.
    -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.18.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.20" />
    <!--
      The logging pipeline of the two API hosts: console and rolling text files, from one typed
      options class. The framework's own logging has no file sink at all, and this meta-package is
      the smallest entry that closes the gap — it carries Serilog itself, both sinks, and the
      hosting integration that swaps the logger factory, so this is the only line needed and the
      transitive pinning above keeps the rest coherent. See ADR 0026.
    -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!--
      The day ADR 0026 reserved: an aggregator exists now, so the two text sinks gain an OTLP
      sibling. The official Serilog sink rather than forwarding through the provider bridge,
      because it ships the rendered message, the structured properties and the enrichers' work —
      the caller ADR 0027 stamps included — with the trace and span identifiers attached, which is
      what makes a log line findable from the trace that produced it. Wired inside AddApiLogging
      alone, like every other sink, and off with the same switch as the rest of the telemetry.
      See ADR 0095.
    -->
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <!--
      The imaging library, under MIT, and the one ADR 0021 named by name when it deferred this:
      ImageSharp was declined there because its license changes for commercial use above a revenue
      threshold, which is not a property a dependency should have. It decodes an uploaded portrait
      and re-encodes it without metadata, which is what keeps a phone's GPS coordinates off a public
      page. See ADR 0063.

      The native half is the *NoDependencies* variant deliberately. The ordinary
      SkiaSharp.NativeAssets.Linux expects libfontconfig1 in the image, because Skia links it for
      text layout — and nothing here lays out text: a portrait is decoded, oriented, resized and
      re-encoded. Taking the ordinary variant would add a system package to
      mcr.microsoft.com/dotnet/aspnet:10.0 in exchange for a capability this repository never uses.
    -->
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
    <!--
      The reverse proxy the Blazor host uses as a BFF: the browser calls its own origin, and this
      forwards to the API with the access token attached server-side. See ADR 0009.
    -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <!--
      The container core, referenced directly rather than only pulled in by Testcontainers.MsSql
      below: the object store the integration suite runs against is a plain SeaweedFS image with no
      module of its own, so the builder is used by hand. Same version as the MsSql module on
      purpose — they share this assembly, and letting them drift resolves one of the two twice.
    -->
    <PackageVersion Include="Testcontainers" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
