<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <!--
      Everything an API host needs and that both of them would otherwise copy: the controller
      bases, the authorization policy, the CORS and identity wiring, the HTTP side of optimistic
      concurrency. It exists so that TrainingHub.Shared.Infrastructure can go back to being
      about persistence alone — it used to carry MVC and authentication for the sole benefit of
      AuthControllerBase, and a policy declared in one host's Program.cs only protects that host.
    -->
    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <!-- For ValidationExceptionHandler alone: the API has to recognize a validation failure to
           answer it as a ValidationProblemDetails. No validator is declared here — the rules stay
           in the application layer, only their translation to HTTP lives at this boundary. -->
      <PackageReference Include="FluentValidation" />
      <!-- The OpenAPI document and its reference UI are configured here, in OpenApiExtensions,
           so both hosts describe the API the same way. -->
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
      <PackageReference Include="Scalar.AspNetCore" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
      <!-- Referenced explicitly rather than through the JwtBearer package: TokenService writes
           tokens with JwtSecurityTokenHandler, which is a different concern from validating them. -->
      <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
      <!-- The logging pipeline both hosts share: LoggingExtensions configures the sinks, and
           ApiLoggingOptions is the whole surface a deployment tunes. See ADR 0026. -->
      <PackageReference Include="Serilog.AspNetCore" />
      <!-- The health dashboard both hosts serve in Development: the UI page and its collector,
           the writer speaking its format, and the in-memory store it forgets on restart. Wired
           by HealthExtensions alone, and a rule keeps the library there. See ADR 0037. -->
      <PackageReference Include="AspNetCore.HealthChecks.UI" />
      <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
      <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" />
      <!-- The telemetry pipeline both hosts share: TelemetryExtensions subscribes the SDK to the
           platform's own sources and to the solution's, and exports the three signals over OTLP.
           Wired by that one seam, and a rule keeps the library there. See ADR 0095. -->
      <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
      <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
      <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
      <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" />
      <!-- The OTLP sibling of the two text sinks, added by AddApiLogging when telemetry is on:
           log lines reach the aggregator with their trace and span identifiers attached. The one
           Serilog rule already confines it to the logging seam. See ADR 0095. -->
      <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
    </ItemGroup>

    <!--
      The application layer is referenced so the HTTP contracts can be mapped to and from it in
      one place. The dependency runs the way the layering requires — the API knows the application
      layer, never the reverse — and it now stops at Contracts/Mappings instead of running through
      every controller signature.
    -->
    <ItemGroup>
      <ProjectReference Include="..\TrainingHub.Shared.Application\TrainingHub.Shared.Application.csproj" />
      <ProjectReference Include="..\TrainingHub.Shared.Infrastructure\TrainingHub.Shared.Infrastructure.csproj" />
      <!-- The languages the hosts answer in: LocalizationExtensions reads the supported set from
           the one authority every surface shares. See ADR 0088. -->
      <ProjectReference Include="..\TrainingHub.Translations\TrainingHub.Translations.csproj" />
    </ItemGroup>

</Project>
